# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# claude
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!src-tauri/.env.example

# tauri / rust
src-tauri/target/
# regenerated by Tauri from tauri.conf.json + capabilities/ on every build — not source
src-tauri/gen/
# sidecar binaries are fetched per-machine, not committed (see src-tauri/binaries/README.md)
src-tauri/binaries/*
!src-tauri/binaries/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
handoff-chat-wonder-access-issue.md
