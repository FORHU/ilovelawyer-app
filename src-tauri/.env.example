# Desktop app settings. Copy to `.env` (same folder) and pick ONE FRONTEND_URL below.
#
# - Read ONCE, when the app starts: after editing, restart `pnpm tauri:dev` (Ctrl+C, run again).
# - Per computer, never committed: each machine has its own `.env`.
# - No secrets here: the web app and the API keep theirs in their own .env files.
# - Every value is optional; a packaged build with no .env uses the defaults.

# ── Which web app the windows show ─────────────────────────────────────────────────────────
# Only one line should be uncommented. With none, it's the local server on FRONTEND_PORT.
#
# Local (your own code + your local API on :3001) — use these to test unmerged work:
#
#   localhost      no site chosen: first launch shows the UK/PH chooser, you pick one and log
#                  in there, and the app remembers it — later launches go straight to that site.
#                  Remembered in %APPDATA%\com.ilovelawyer.desktop\last-site.txt (delete it to
#                  see the chooser again).
#   uk./ph.        always that site, no chooser.
#
FRONTEND_URL=http://localhost:3002
# FRONTEND_URL=http://uk.localhost:3002
# FRONTEND_URL=http://ph.localhost:3002
#
# Deployed (built from `main`, so no unmerged changes; needs no local servers). These are LIVE
# shared staging environments — look around freely, but check with the team before creating
# data there.
#
# FRONTEND_URL=https://uk-dev.ilovelawyer.com
# FRONTEND_URL=https://ph-dev.ilovelawyer.com

# ── Rarely changed ─────────────────────────────────────────────────────────────────────────
# Port of the local web server — only used when FRONTEND_URL is unset (and by a packaged build's
# bundled server). If you change it, also change devUrl in src-tauri/tauri.conf.json, which the
# Tauri CLI reads directly (it only tells the CLI when Next.js is ready — it is NOT the address
# the window loads; FRONTEND_URL is).
FRONTEND_PORT=3002

# Title bar text for every window.
WINDOW_TITLE=I Love Lawyer Terminal!
