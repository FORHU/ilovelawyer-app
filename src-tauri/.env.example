# Desktop-shell-only config — deliberately just the two things specific to this Tauri app
# itself. No app/API secrets belong here: ilovelawyer-app and ilovelawyer-api each manage
# their own credentials in their own .env files. See docs/architecture.md's core rule.
#
# Both are optional; hardcoded defaults are used if unset or this file doesn't exist at all
# (e.g. a packaged production build).

# Port the desktop windows load (and, in production, the port the bundled sidecar listens on).
# Default: 3002. If you change this for `tauri dev`, also update devUrl in
# src-tauri/tauri.conf.json to match — that file is read by the Tauri CLI directly and doesn't
# see this .env.
FRONTEND_PORT=3002

# Window title for every Terminal window.
# Default: "I Love Lawyer Terminal!"
WINDOW_TITLE=I Love Lawyer Terminal!

# Full base URL override — points every window at an already-deployed remote server instead of
# a local dev server/sidecar (e.g. a staging deployment). When set, FRONTEND_PORT is ignored
# and no local sidecar is ever spawned. Unset by default — local dev is the default behavior.
# If you point this at a shared staging/live environment, treat it as read-only unless you've
# checked that taking real actions against it (logging in, creating data) is expected.
# FRONTEND_URL=https://ph-dev.ilovelawyer.com
